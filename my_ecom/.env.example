# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
# IMPORTANT: wrap SECRET_KEY in double quotes if it contains #, $, or spaces.
# Example: SECRET_KEY="your-long-random-key-here"

# Django
SECRET_KEY="change-me-to-a-long-random-string"
DEBUG=False
ALLOWED_HOSTS=manirshop.com,www.manirshop.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://manirshop.com,https://www.manirshop.com,http://localhost:8000,http://127.0.0.1:8000

# Serve uploaded media via Django (True for local; use Nginx/S3 in production)
SERVE_MEDIA=True

# HTTPS-only cookies (set True behind HTTPS / reverse proxy)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Google OAuth (create NEW credentials — old ones were exposed in git history)
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=

# Email / SMTP (create a NEW app password — old one was exposed)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
